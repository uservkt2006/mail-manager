{
  "name": "mail-manager",
  "version": "3.6.0",
  "description": "Mail Manager - Exchange email client for Ubuntu",
  "main": "electron/main.cjs",
  "author": "Võ Khắc Tâm <vokhactam01@gmail.com>",
  "homepage": "https://tmtool.click",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:electron\"",
    "dev:frontend": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "vite build",
    "package": "electron-builder"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "date-fns": "^2.30.0",
    "dompurify": "^3.4.15",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-resizable-panels": "^4.12.4"
  },
  "build": {
    "appId": "com.tmtool.mailmanager",
    "productName": "Mail Manager",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "../build/icon.png",
      "../build/icon.ico"
    ],
    "extraResources": [
      {
        "from": "../build",
        "to": "build",
        "filter": ["**/*"]
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "category": "Office",
      "maintainer": "Võ Khắc Tâm <vokhactam01@gmail.com>",
      "vendor": "TM TOOL",
      "desktop": {
        "Name": "Mail Manager",
        "Comment": "Desktop email client",
        "Categories": "Office;Network;Email;",
        "MimeType": "x-scheme-handler/mailto;",
        "StartupWMClass": "Mail Manager"
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "../build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mail Manager"
    }
  }
}
